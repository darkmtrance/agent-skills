---
interface Props { command: string; label?: string }
const { command, label } = Astro.props;
---
<div class="cmd">
  {label && <span class="cmd-label">{label}</span>}
  <div class="cmd-row">
    <code><span class="prompt" aria-hidden="true">$</span>{command}</code>
    <button type="button" class="copy" data-copy={command} aria-label={`Copiar: ${command}`}>Copiar</button>
  </div>
</div>
