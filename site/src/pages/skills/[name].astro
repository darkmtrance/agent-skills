---
import Base from '../../layouts/Base.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import { getSkills, commands, githubUrl, shortDescription, type Skill } from '../../lib/skills';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

export function getStaticPaths() {
  return getSkills().map((skill) => ({ params: { name: skill.name }, props: { skill } }));
}
const { skill } = Astro.props as { skill: Skill };
const rawHtml = await marked.parse(skill.body);
const html = sanitizeHtml(rawHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat([
    'h1',
    'h2',
    'img',
    'del',
    'details',
    'summary',
  ]),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ['href', 'title', 'rel'],
    img: ['src', 'alt', 'title'],
    code: ['class'],
    th: ['align'],
    td: ['align'],
  },
  allowedSchemes: ['http', 'https', 'mailto'],
  allowedSchemesByTag: {
    img: ['http', 'https'],
  },
  transformTags: {
    a: sanitizeHtml.simpleTransform('a', { rel: 'noopener noreferrer' }),
  },
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={skill.name} description={shortDescription(skill.description)}>
  <a class="back" href={`${base}/`}>← Todos los skills</a>
  <div class="detail">
    <article>
      <h1>{skill.name}</h1>
      <p class="lead">{skill.description}</p>
      <CopyCommand label="Instalar en este proyecto" command={commands.one(skill.name)} />
      <CopyCommand label="Instalar global para Claude Code" command={commands.claude(skill.name)} />
      <CopyCommand label="Instalar global para GitHub Copilot" command={commands.copilot(skill.name)} />
      <details class="skillmd">
        <summary>Ver SKILL.md</summary>
        <div class="prose" set:html={html} />
      </details>
    </article>
    <aside>
      <dl>
        {skill.version && (<><dt>Versión</dt><dd>{skill.version}</dd></>)}
        {skill.license && (<><dt>Licencia</dt><dd>{skill.license}</dd></>)}
        {skill.author && (<><dt>Autor</dt><dd>{skill.author}</dd></>)}
        {skill.source && (
          <>
            <dt>Origen</dt>
            <dd><a href={skill.source.url} target="_blank" rel="noopener">{skill.source.repo}</a></dd>
          </>
        )}
        <dt>Tamaño</dt><dd>{skill.fileCount} archivos · {skill.sizeKB.toLocaleString('es')} KB</dd>
      </dl>
      <h2>Contenido</h2>
      <ul class="files">{skill.files.map((f) => <li>{f}</li>)}</ul>
      <a class="button" href={githubUrl(skill.name)} target="_blank" rel="noopener">Ver en GitHub</a>
    </aside>
  </div>
</Base>
